{
  "name": "clary",
  "private": true,
  "description": "CLARY SaaS Platform for Healthcare",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:clinic": "npm run dev -w apps/clinic-app",
    "dev:admin": "npm run dev -w apps/admin-app",
    "dev:backend": "npm run dev -w apps/backend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:admin\" \"npm:dev:clinic\"",
    "test": "npm run test -w apps/clinic-app",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2"
  }
}
