{
  "name": "clary",
  "private": true,
  "description": "CLARY SaaS Platform for Healthcare",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:clinic": "npm run dev -w apps/clinic-app",
    "dev:admin": "npm run dev -w apps/admin-app",
    "dev:backend": "npm run dev -w apps/backend",
    "dev": "npm run dev -w apps/clinic-app",
    "test": "npm run test -w apps/clinic-app",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install",
    "validate:permissions": "node scripts/validate-permission-matrix.mjs",
    "migrate": "bash scripts/migrate.sh",
    "deploy:functions": "bash scripts/deploy-functions.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
